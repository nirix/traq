<?php extendView('layouts/default.phtml'); ?>

<div class="usercp content">
	<h2 class="page-title"><?= l('usercp') ?></h2>
</div>
<?= View::render('usercp/_nav') ?>
<table class="list">
	<thead>
		<tr>
			<th><?= l('type') ?></th>
			<th><?= l('for') ?></th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		<?php foreach ($subscriptions as $sub) : ?>
			<tr>
				<td><?= l($sub->type) ?></td>
				<?php if ($sub->type == 'project' || $sub->type == 'milestone') : ?>
					<td><?= HTML::link($sub->object()->name, $sub->object()->href()) ?></td>
				<?php elseif ($sub->type == 'ticket') : ?>
					<td><?= HTML::link($sub->object()->summary, $sub->object()->href()) ?></td>
				<?php endif; ?>
				<td>
					<form action="<?= Request::base($sub->object()->href('unsubscribe')) ?>" method="post" class="inline">
						<input type="hidden" name="_method" value="DELETE">
						<button type="submit" class="btn-link"><?= l('unsubscribe') ?></button>
					</form>
				</td>
			</tr>
		<?php endforeach; ?>
		<?php if (empty($subscriptions)) : ?>
			<tr>
				<td colspan="3" class="text-center"><?= l('subscriptions.no_subscriptions') ?></td>
			</tr>
		<?php endif; ?>
	</tbody>
</table>
