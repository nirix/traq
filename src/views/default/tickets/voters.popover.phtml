<?php if (count($voters)): ?>
	<div class="popover-content">
		<ol class="voters">
			<?php foreach (array_slice($voters, 0, 5) as $voter): ?>
				<li><?= HTML::link(e($voter->username), $voter->href()) ?></li>
			<?php endforeach; ?>
		</ol>
	</div>
	<?php if (count($voters) > 5): ?>
		<div class="popover-footer">
			<?= HTML::link(l('see_all'), Request::uri(), ['data-overlay' => true]) ?>
		</div>
	<?php endif; ?>
<?php else: ?>
	<div class="popover-content">
		<?= l('no_votes'); ?>
	</div>
<?php endif; ?>
