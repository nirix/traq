						<span class="visually-hidden"><?= l('edit_page') ?></span>
					</a>
				<?php endif; ?>
				<a href="<?= Request::base($page->href('_revisions')) ?>" class="btn-secondary btn-soft btn-sm" title="<?= l('revisions') ?>">
