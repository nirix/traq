<?php extendView('layouts/default.phtml'); ?>

<div class="content">
	<h2 class="page-title"><?= l('project_settings'); ?></h2>
</div>
<?= View::render('project_settings/_nav'); ?>
<form action="<?= Request::requestUri(); ?>" method="post">
	<table class="permissions list">
		<thead>
			<tr>
				<th><?= l('action'); ?></th>
				<?php foreach ($groups as $group) : ?>
					<th><?= e($group->name); ?></th>
				<?php endforeach; ?>
			</tr>
		</thead>
		<tbody>
			<?php foreach ($actions as $key => $action) : ?>
				<?php if (is_array($action)) : ?>
					<tr class="permission_section">
						<td colspan="<?= count($groups) + 1; ?>"><strong><?= l($key); ?></strong></td>
					</tr>
			<?php foreach ($action as $act) :
						echo View::render('project_settings/permissions/_permission_row', ['key' => $key, 'action' => $act]);
					endforeach;
				else:
					echo View::render('project_settings/permissions/_permission_row', ['action' => $action]);
				endif;
			endforeach; ?>
		</tbody>
	</table>
	<div class="actions">
		<?= Form::submit(l('save')); ?>
	</div>
</form>
