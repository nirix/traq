{
    "name": "traq/traq",
    "description": "Project management system",
    "type": "project",
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "preferred-install": {
            "avalon/framework": "source"
        }
    },
    "require-dev": {
        "filp/whoops": "^2.18.7",
        "phpstan/phpstan": "^2.3.2",
        "phpunit/phpunit": "^13.4"
    },
    "license": "GPLv3",
    "authors": [
        {
            "name": "Jack Polgar",
            "email": "hello@jp.id.au"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "symfony/mailer": "^7.4.19",
        "ramsey/uuid": "^4.7",
        "avalon/framework": "0.9.x-dev",
        "league/commonmark": "^2.10.4",
        "google/recaptcha": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "traq\\": "vendor/traq",
            "Traq\\": "src/Traq"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Traq\\Tests\\": "tests/"
        }
    }
}
